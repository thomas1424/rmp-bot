{
  "manifest_version": 3,
  "name": "RMP-Bot",
  "version": "0.1.0",
  "description": "Shows RateMyProfessor info directly inside your school registration portal.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "RMP-Bot"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ellucian.com/*",
        "https://*.chaffey.edu/*",
        "https://*.valleycollege.edu/*"
      ],
      "css": ["src/styles.css"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}